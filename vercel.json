{
  "cleanUrls": true,
  "functions": {
    "api/proxy.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/iptv-app/index.html" },
    { "source": "/src/(.*)", "destination": "/iptv-app/src/$1" },
    { "source": "/(.*)", "destination": "/iptv-app/$1" }
  ]
}
