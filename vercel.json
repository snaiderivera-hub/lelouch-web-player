{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/playlist/version/:token", "destination": "/api/playlist?token=:token&format=version" },
    { "source": "/api/playlist/manifest/:token", "destination": "/api/playlist?token=:token&format=json" },
    { "source": "/api/playlist/:token", "destination": "/api/playlist?token=:token" },
    { "source": "/", "destination": "/iptv-app/index.html" },
    { "source": "/src/(.*)", "destination": "/iptv-app/src/$1" },
    { "source": "/((?!api/).*)", "destination": "/iptv-app/$1" }
  ]
}
